<!DOCTYPE html>
<html lang="vi">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - SAKURA</title>

    <link rel="stylesheet"
          href="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/css/bootstrap.min.css" />

    <link href="https://fonts.googleapis.com/css2?family=Poppins:wght@300;400;500;600;700&display=swap"
          rel="stylesheet" />

    <link rel="stylesheet" href="~/css/site.css"  asp-append-version="true" />
</head>
<body>

    <header>
        <nav class="navbar navbar-default">
            <div class="container-fluid">
                <div class="navbar-header">
                    <button type="button"
                            class="navbar-toggle"
                            data-toggle="collapse"
                            data-target="#myNavbar">
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                        <span class="icon-bar"></span>
                    </button>

                    <a class="navbar-brand" href="/">
                        <img src="/prj/logo.jpg" class="img-responsive" alt="SAKURA Logo" />
                    </a>
                </div>

                <div class="collapse navbar-collapse" id="myNavbar">
                    <ul class="nav navbar-nav navbar-right">
                        <li><a asp-page="/Index"><strong>TRANG CHỦ</strong></a></li>
                        <li><a asp-page="/T-shirt"><strong>ÁO THUN</strong></a></li>
                        <li><a asp-page="/shirt"><strong>SƠ MI</strong></a></li>
                        <li><a asp-page="/pants"><strong>QUẦN</strong></a></li>
                        <li><a asp-page="/accessories"><strong>PHỤ KIỆN</strong></a></li>
                    </ul>
                </div>
            </div>
        </nav>

        <div class="jumbotron text-center">
            <div class="container">
                <div class="row">
                    <div class="col-sm-10">
                        <form action="/Search" method="get">
                            <div class="input-group">
                                <input type="text"
                                       name="q"
                                       class="form-control"
                                       placeholder="Tìm kiếm sản phẩm" />

                                <div class="input-group-btn">
                                    <button type="submit" class="btn btn-danger">
                                        Search
                                    </button>
                                </div>
                            </div>
                        </form>
                    </div>

                    <div class="col-sm-2 header-icon">
                        <a href="/Wishlist">
                            <span class="glyphicon glyphicon-heart"></span>
                        </a>
                        <a asp-page = "/shopping_cart">
                            <span class="glyphicon glyphicon-shopping-cart"></span>
                        </a>
                        <a asp-page = "/wishlist">
                            <span class="glyphicon glyphicon-user"></span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </header>

    <main>
        @RenderBody()
    </main>

    if(ViewData["hideFooter"] == null){
    <div class="container-fluid footer">
        <div class="container">
            <img src="/prj/logo2.png"
                 class="img-responsive center-block"
                 alt="SAKURA" />

            <div class="row text-center">
                <div class="col-sm-4">
                    <h4><strong>SAKURA:</strong></h4>
                    <ul>
                        <li><p>Thành lập: năm 2026</p></li>
                        <li><p>Thiết kế độc quyền</p></li>
                        <li><p>Chất liệu cao cấp</p></li>
                        <li><p>Giao hàng toàn quốc</p></li>
                        <li>
                            <p id="gt">
                                Cảm ơn bạn đã lựa chọn SAKURA! Sự tin tưởng và
                                đồng hành của bạn là nguồn cảm hứng để chúng tôi
                                không ngừng mang đến những sản phẩm chất lượng
                                và phong cách. Chúc bạn luôn tự tin và tỏa sáng
                                cùng SAKURA.
                            </p>
                        </li>
                    </ul>
                </div>

                <div class="col-sm-4">
                    <h4><strong>Danh mục:</strong></h4>
                    <ul>
                        <li><a href="/TShirt">Áo thun</a></li>
                        <li><a href="/Shirt">Áo sơ mi</a></li>
                        <li><a href="/Accessories">Phụ kiện</a></li>
                        <li><a href="/Pants">Quần</a></li>
                    </ul>
                </div>

                <div class="col-sm-4">
                    <h4><strong>Liên hệ:</strong></h4>
                    <ul>
                        <li><p>Hotline: 1900 692 007</p></li>
                        <li><p>Email: Business@sakura.asia</p></li>
                        <li><p>Page: SAKURA | Clothing</p></li>
                        <li><p>Instagram: SAKURA | Clothing</p></li>
                        <li><p>Tiktok: SAKURA</p></li>
                    </ul>
                </div>
            </div>

            <hr />
            <p class="text-center">© 2026 SAKURA. All Rights Reserved.</p>
        </div>
    </div>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="https://maxcdn.bootstrapcdn.com/bootstrap/3.4.1/js/bootstrap.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>
    
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>