@page
@model SAKURA.Pages.DetailModel

@{
    ViewData["Title"] = "Chi tiết sản phẩm";
}
        <div class="container-fluid">
            <div class="row">
                <div class="col-md-5 ">
                  @{
    var mainImage = Model.ImageUrls.FirstOrDefault();
}

@if (!string.IsNullOrEmpty(mainImage))
{
    <img src="@mainImage" class="img-responsive" alt="@Model.ProductName" class="main-product-image" />
}
                </div>
                <div class="col-md-7">
                    <div class="products-info">
                        <h2>@Model.ProductName</h2>
                        <h3>@Model.Price.ToString("N0") VND </h3>
                        <div class="products-color">
                            <h5 class="title">Color</h5>
                            <div class="color-list">
                               @foreach (var image in Model.ImageUrls)
                               {
                                <img src="@Url.Content("~/"+ image)" alt = "@Model.ProductName" class="color-item active">
                               }
                            
                            </div>
                        </div>


                        <h5 class="title">Size</h5>
                        <button class="btn btn-default">S</button>
                        <button class="btn btn-default">M</button>
                        <button class="btn btn-default">L</button>
                        <button class="btn btn-default">XL</button>

                        <div class="form-group">
                            <label class="title">Số lượng</label>
                            <div class="quantity">
                                <button class="btn btn-default">-</button>
                                <input type="text" class="form-control text-center" value="1" readonly>
                                <button class="btn btn-default">+</button>
                            </div>
                        </div>

                        <div>
                            <button class="btn btn-danger btn-lg">
                                Thêm vào giỏ hàng
                            </button>

                            <button class="btn btn-danger btn-lg">
                                Mua ngay
                            </button>
                        </div>

                        <div class="filter">
                            <div class="information">
                                <h4>
                                    <a href="#information" data-toggle="collapse">Thông tin sản phẩm<span
                                            class="caret"></span></a>
                                </h4>
                                <div id="information" class="collapse ">
                                    <ul>
                                        <h3>Mô tả sản phẩm</h3>
                                        <li>@Model.Description</li>
                                        <h3>Đặc điểm nổi bật</h3>
                                        <li>Thiết kế unisex phù hợp cho cả nam và nữ.</li>
                                        <li>Chất liệu mềm mại, mang lại cảm giác thoải mái khi mặc.</li>
                                        <li>Phù hợp mặc hằng ngày, đi học, đi làm hoặc dạo phố.</li>
                                        <h3>Chất Liệu</h3>
                                        <li>Cotton cao cấp.</li>
                                        <li>Mềm mại và thoáng khí.</li>
                                        <li>Đường may chắc chắn, bền đẹp.</li>
                                        <li>Ít nhăn, giữ form sau nhiều lần giặt.</li>
                                        <h3>Hướng dẫn bảo quản</h3>
                                        <li>Giặt ở nhiệt độ dưới 30°C.</li>
                                        <li>Lộn mặt trái khi giặt.</li>
                                        <li>Không sử dụng chất tẩy mạnh.</li>
                                        <li>Phơi nơi thoáng mát, tránh ánh nắng gắt.</li>
                                        <li>Ủi ở nhiệt độ thấp.</li>
                                        <li>Không sấy ở nhiệt độ cao.</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="delivery">
                                <h4>
                                    <a href="#delivery" data-toggle="collapse">Chính sách vận chuyển<span
                                            class="caret"></span></a>
                                </h4>
                                <div id="delivery" class="collapse ">
                                    <ul>
                                        <h3>Chính sách</h3>
                                        <li>🚚 Giao hàng toàn quốc.</li>
                                        <li>🔄 Hỗ trợ đổi size trong vòng 7 ngày.</li>
                                        <li>🔒 Thanh toán an toàn.</li>
                                        <li>📦 Kiểm tra hàng trước khi thanh toán</li>
                                    </ul>
                                </div>
                            </div>
                            <div class="return">
                                <h4>
                                    <a href="#return" data-toggle="collapse">Chính sách đổi trả<span
                                            class="caret"></span></a>
                                </h4>
                                <div id="return" class="collapse ">
                                    <ul>
                                        <h3>Điều kiện đổi trả</h3>
                                        <li>Đổi sản phẩm trong vòng 07 ngày kể từ ngày nhận hàng.</li>
                                        <li>Sản phẩm còn mới 100%, chưa qua sử dụng.</li>
                                        <li>Còn đầy đủ tem, nhãn mác và bao bì gốc</li>
                                        <li>Có hóa đơn hoặc thông tin xác nhận đơn hàng.</li>
                                        <li>Sản phẩm bị hư hỏng trong quá trình vận chuyển.</li>
                                        <h3>Trường hợp không áp dụng</h3>
                                        <li>Sản phẩm đã qua sử dụng, giặt hoặc bị bẩn.</li>
                                        <li>Sản phẩm bị hư hỏng do người sử dụng.</li>
                                        <li>Thiếu tem, nhãn mác hoặc phụ kiện đi kèm.</li>
                                        <li>Yêu cầu đổi trả sau thời hạn 07 ngày.</li>
                                        <h3>Quy trình đổi trả</h3>
                                        <li>Liên hệ bộ phận chăm sóc khách hàng qua Hotline hoặc Email.</li>
                                        <li>Cung cấp mã đơn hàng và hình ảnh sản phẩm (nếu có lỗi).</li>
                                        <li>Nhân viên xác nhận thông tin và hướng dẫn gửi sản phẩm.</li>
                                        <li>Sau khi kiểm tra, SAKURA sẽ tiến hành đổi sản phẩm hoặc hoàn tiền theo
                                            chính
                                            sách.</li>
                                        <h3>Chi phí đổi trả</h3>
                                        <li>Miễn phí đối với sản phẩm lỗi từ nhà sản xuất hoặc giao sai đơn hàng.
                                        </li>
                                        <li>Khách hàng thanh toán phí vận chuyển nếu đổi size hoặc đổi theo nhu cầu
                                            cá
                                            nhân.Gợi ý hiển thị trên website</li>
                                    </ul>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            <h2 class=" text-center"> BEST SELLER</h2>
            <div class="row">
                <div class="col-xs-6 col-sm-6 col-md-3">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img src="prj/SAKURA Blossom Backpack.png" class="product-img">
                        </div>
                        <div class="panel-footer">
                            <h3>650.000 VND</h3>
                            <h5><a href="box7.html">SAKURA Blossom Backpack </a><span></span></h5>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6 col-sm-6 col-md-3">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img src="prj/SAKURA Blossom Jersey.png" class="product-img">
                        </div>
                        <div class="panel-footer">
                            <h3>470.000 VND</h3>
                            <h5><a href="box2.html">SAKURA Blossom Jersey </a><span></span></h5>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6 col-sm-6 col-md-3">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img src="prj/SAKURA Essence Shorts.png" class="product-img">
                        </div>
                        <div class="panel-footer">
                            <h3>450.000 VND</h3>
                            <h5><a href="SAKURA/box6.html">SAKURA Essence Shorts</a><span></span></h5>
                        </div>
                    </div>
                </div>

                <div class="col-xs-6 col-sm-6 col-md-3">
                    <div class="panel panel-default text-center">
                        <div class="panel-body">
                            <img src="prj/SAKURA Blossom Raglan.png" class="product-img">
                        </div>
                        <div class="panel-footer">
                            <h3>720.000 VND</h3>
                            <h5><a href="box9.html">SAKURA Blossom Raglan</a><span></span></h5>
                        </div>
                    </div>
                </div>  
            </div>
        </div>
